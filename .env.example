# Copy to .env and fill in the keys you have. Sources without a key are skipped.
# .env is git-ignored; never commit real keys.

# https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# abuse.ch Auth-Key, one key for URLhaus and ThreatFox - https://auth.abuse.ch/
ABUSECH_AUTH_KEY=

# Optional: raises GreyNoise Community quota - https://viz.greynoise.io/signup
GREYNOISE_API_KEY=

# Censys: Platform personal access token, or the older API_ID:API_SECRET - https://platform.censys.io/
CENSYS_API_KEY=
# Only if your Censys token needs an organization ID
CENSYS_ORG_ID=

# Optional: works without a key, a key adds urlscan's verdict - https://urlscan.io/user/signup
URLSCAN_API_KEY=

# Optional: passive DNS (mnemonic) works without a key; an Argus key lifts the public limits (10/min, 1,000/day)
PDNS_API_KEY=

# OpenCTI: your platform URL and a user API token (written from the public schema, not tested live)
OPENCTI_URL=
OPENCTI_TOKEN=

# Keys can also be entered with "intelscope keys set <source>" or in the dashboard (API keys view).
# Where credentials and the IOC tracker are stored; default is your user profile.
# INTELSCOPE_HOME=
# INTELSCOPE_TRACKER=

# Optional: your own ASN blocklist file (one ASN per line), checked with Spamhaus ASN-DROP
INTELSCOPE_ASN_BLOCKLIST=
